<Window x:Class="PowerManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设置"
        Icon="/Assets/power.ico"
        Width="480"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" Style="{StaticResource HeaderTitleTextStyle}" />

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="通用" Style="{StaticResource SectionTitleTextStyle}" />
                <CheckBox x:Name="StartupCheckBox"
                          Content="开机自动启动猪猫帮你关" />
                <CheckBox x:Name="MinimizeToTrayCheckBox"
                          Content="关闭主窗口时最小化到系统托盘（推荐）" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="22,6,0,0"
                           Text="勾选后关闭窗口不等于退出；可右键系统托盘图标选择「退出应用」。" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    Content="保存"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
